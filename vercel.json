{
  "name": "elabbar-prod",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    }
  ],
  "installCommand": "echo 'skipping install'",
  "buildCommand": "echo 'skipping build'",
  "framework": null
}
